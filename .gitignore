# Python
__pycache__/
*.pyc
.venv/
.idea/

# Raw competition data -- heavy, fetch from the Kaggle dataset instead
# (see README.md for exact download commands). data/splits/ is OUR derived
# artifact (small, reproducibility-critical) and IS tracked -- don't add a
# blanket data/ rule here.
data/*.parquet

# Model / tokenizer weight files -- heavy, fetch from Kaggle datasets or
# regenerate via scripts/merge_lora.py (see README.md).
*.safetensors
*.onnx
*.msgpack
*.bin
*.pt
*.pth
submits/minilm/lora/models/
submits/minilm/lora/classifier.pt

# Every submits/<family>/<variant>/ build directory -- local copies of base
# model weights, tokenizer vocab/merge files, offline-install pip wheels,
# and packaged submission zips are all heavy and 100% regenerable from this
# project's own Kaggle datasets/kernels + each submission's build script
# (see AGENTS.md, submits/<family>/<variant>/src/utils.py). `**` because
# submits/ is organized in family/variant subdirectories (submits/berta/...,
# submits/frida/...) and at least one variant (berta/catboost_256_len)
# nests a full second build dir inside itself, one level deeper still.
submits/**/models/
submits/**/wheels/
submits/**/*.zip

# Cross-encoder-size probe submissions (submits/probes/<family>/) --
# downloaded HF/Kaggle weights + fitted classifier + offline-install wheels
# + zip, all regenerable via scripts/download_probe_models.py +
# scripts/fit_probe_classifier.py + scripts/build_submission_zip.py, or
# (giga3b) `kaggle datasets download maxamsecret/giga3b-quantize` +
# pip-downloading the pinned wheels (see AGENTS.md and
# submits/probes/giga3b/src/model.py).
submits/probes/*/models/
submits/probes/*/*.joblib
submits/probes/*/wheels/

# Submission archives -- regenerate via scripts/build_submission_zip.py.
# The tiny organizer-provided lightweight baseline zip IS tracked as
# reference (negated below, since submits/**/*.zip above would otherwise
# catch it too); the 1.2GB weights-bundled one is not (also exceeds
# GitHub's 100MB per-file limit regardless).
submits/minilm/lora/matching-lora-submit.zip
submits/minilm/baseline/matching-baseline-submit.zip
submits/probes/*/matching-*-submit.zip
!submits/minilm/baseline/matching-baseline-lightweight.zip

# Ad-hoc downloaded/extracted submission archives (manually pulled from an
# external test-bench link, not produced by this repo's own build scripts).
# If one of these becomes the shipped variant, promote just the small code
# (run.py/src/utils.py/metadata.json) into a proper tracked submits/
# dir by hand -- don't unignore the whole folder.
submits/matching-*-submit/

# Kaggle kernel run artifacts -- downloaded outputs/pulled sources,
# regenerate by re-running the kernel (see kernel-metadata.json next to each
# script). ** (not a single *) because kernels now live 2-4 levels deep
# under kaggle_kernels/ (e.g. kaggle_kernels/frida/lora/tpu-human-sft/) --
# a single-level glob here silently stopped matching after that restructure
# and let ~90 output/log/checkpoint files get committed by accident.
kaggle_kernels/**/output/
kaggle_kernels/**/pulled/
*.log

# Root-level temporary files/directories created by PR inspection and
# downloaded Kaggle source inspection.
/.tmp_*

# Scratch / local test artifacts (downloaded adapters, extracted zips for
# testing, sampled parquet files, prediction CSVs from smoke tests).
artifacts/

# Local staging directories for publishing large Kaggle datasets. Their
# metadata and payloads are regenerated from tracked builder/kernel code.
/kaggle_datasets/

# Kaggle API credentials -- real API keys, never commit. Root-anchored so
# this doesn't touch kaggle_kernels/*/kernel-metadata.json or the tracked
# .claude/skills/kaggle/ skill.
/kaggle.json
/kaggle*.json

# OS / editor cruft
.DS_Store
Thumbs.db

# Claude Code local/ephemeral state -- per-machine permissions and runtime
# locks, not shared project config (.claude/skills/ IS tracked, it's the
# project's Kaggle skill).
.claude/settings.local.json
.claude/*.lock

# Personal local tooling (multi-account Kaggle quota checker), not part of
# this project -- lives under the shared kaggle skill for discoverability
# but is per-machine, not shared project config. The rest of
# .claude/skills/kaggle/ IS tracked (see above).
.claude/skills/kaggle/modules/setup/scripts/check_all_quotas.py
.agents/skills/kaggle/modules/setup/scripts/check_all_quotas.py
