{
  "version": "c_rule_registry_v1_3",
  "description": "Initial structured rules derived from negative_patterns. Catalog evidence is a prior only; all support is re-audited on canonical human train.",
  "rules": [
    {
      "rule_id": "c_auto_part_number",
      "category": "Автотовары",
      "catalog_pattern": 1,
      "target_concepts": ["article", "oem_number"],
      "target_mode": "any",
      "min_target_differences": 1,
      "disallow_any_target_overlap": true,
      "item_type_allow_regex": "тормозн|колодк|сайлентблок|шрус|фильтр|рычаг|ремень|ролик|подшипник|амортизатор|свеч|насос|стартер|генератор|датчик|ступиц",
      "item_name_deny_regex": "автошин|покрыш|\\bшина\\b|\\br\\s?\\d{2}\\b",
      "context_concepts": ["brand", "item_type"],
      "min_context_matches": 2,
      "prior_confidence": "strict",
      "operation": "Replace a complete manufacturer/OEM identifier with a real identifier from the same brand and part-type context."
    },
    {
      "rule_id": "c_auto_tire_full_spec",
      "category": "Автотовары",
      "catalog_pattern": 3,
      "target_concepts": ["tire_width", "tire_profile", "tire_diameter"],
      "target_mode": "all",
      "min_target_differences": 3,
      "disallow_any_target_overlap": false,
      "item_type_allow_regex": "шин|покрыш|колес",
      "context_concepts": ["brand", "seasonality", "item_type"],
      "min_context_matches": 2,
      "prior_confidence": "strict",
      "operation": "Replace the complete tire width/profile/rim-diameter specification with another real coherent train specification."
    },
    {
      "rule_id": "c_auto_platform",
      "category": "Автотовары",
      "catalog_pattern": 4,
      "target_concepts": ["car_make", "car_model"],
      "target_mode": "all",
      "min_target_differences": 1,
      "disallow_any_target_overlap": false,
      "item_type_allow_regex": "оплетк|чехол|накидк|коврик|органайзер|магнитол|рамк|дефлектор|защит|подлокот|шторк|багажник",
      "context_concepts": ["item_type", "brand", "general_material"],
      "required_context_concepts": ["item_type"],
      "min_context_matches": 1,
      "prior_confidence": "guarded",
      "operation": "Replace an explicit model-specific target vehicle platform while preserving the accessory construction."
    },
    {
      "rule_id": "c_shoes_model",
      "category": "Обувь",
      "catalog_pattern": 3,
      "target_concepts": ["product_model"],
      "target_value_policy": "identifier_like",
      "target_mode": "all",
      "min_target_differences": 1,
      "disallow_any_target_overlap": true,
      "context_concepts": ["brand"],
      "required_context_concepts": ["brand"],
      "min_context_matches": 1,
      "prior_confidence": "guarded",
      "operation": "Replace an explicit model/version with another real model from the same canonical shoe brand."
    },
    {
      "rule_id": "c_jewelry_base_metal",
      "category": "Ювелирные изделия",
      "catalog_pattern": 1,
      "target_concepts": ["jewelry_material", "metal_fineness"],
      "target_mode": "all",
      "min_target_differences": 1,
      "required_different_concepts": ["jewelry_material"],
      "disallow_any_target_overlap": false,
      "context_concepts": ["item_type", "brand"],
      "required_context_concepts": ["item_type"],
      "min_context_matches": 1,
      "prior_confidence": "strict",
      "operation": "Replace the explicitly declared base metal together with a coherent real fineness while preserving product form and the available family context."
    },
    {
      "rule_id": "c_jewelry_article",
      "category": "Ювелирные изделия",
      "catalog_pattern": 3,
      "target_concepts": ["article"],
      "target_value_policy": "identifier_like",
      "target_mode": "all",
      "min_target_differences": 1,
      "disallow_any_target_overlap": true,
      "context_concepts": ["brand", "item_type", "jewelry_material", "metal_fineness"],
      "required_context_concepts": ["brand"],
      "min_context_matches": 2,
      "prior_confidence": "strict",
      "operation": "Replace a complete manufacturer article/model code with another real code inside a matching jewellery context."
    },
    {
      "rule_id": "c_clothing_functional_type",
      "category": "Одежда",
      "catalog_pattern": 1,
      "target_concepts": ["item_type"],
      "target_mode": "all",
      "min_target_differences": 1,
      "disallow_any_target_overlap": true,
      "context_concepts": ["gender", "brand"],
      "min_context_matches": 1,
      "prior_confidence": "strict",
      "operation": "Replace an explicit garment functional type inside a preserved wearer/brand context; coordinated sets remain excluded."
    }
  ]
}
